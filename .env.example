PORT=3000
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_DEFAULT_SHEET=Sheet1
COSTOS_OPERACIONES_SPREADSHEET_ID=1S5pHKwGPRa_sS3Mc2knwennA2IhNSXDtJ3sEK_On0aM
COSTOS_OPERACIONES_SHEET_NAME=Costos Operaciones
MADRE_API_BASE_URL=https://api.madre.loquieroaca.com
# MADRE_API_INTERNAL_API_KEY=your-internal-api-key

# BullMQ / Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_TLS=false
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379
SHEET_ORDER_QUEUE_CONCURRENCY=1
SHEET_ORDER_QUEUE_RATE_LIMIT_MAX=1
SHEET_ORDER_QUEUE_RATE_LIMIT_DURATION_MS=1000
SHEET_ORDER_QUEUE_ATTEMPTS=5
SHEET_ORDER_QUEUE_BACKOFF_MS=5000
SHEET_ORDER_QUEUE_REMOVE_ON_COMPLETE=1000
SHEET_ORDER_QUEUE_REMOVE_ON_FAIL=5000

# Bull Board panel
BULL_BOARD_ENABLED=false
BULL_BOARD_PATH=/admin/queues
# BULL_BOARD_USERNAME=admin
# BULL_BOARD_PASSWORD=change-me

# Option A: path to the downloaded service account json, useful locally.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: full service account json encoded as base64, useful for deployments.
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...

# Option C: inline credentials split into two variables.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
